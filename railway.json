{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install && npx prisma generate"
    },
    "deploy": {
        "startCommand": "bash -c \"ulimit -u unlimited 2>/dev/null; ulimit -n 65536 2>/dev/null; exec node --max-old-space-size=2048 /app/collector/collector.mjs\"",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}